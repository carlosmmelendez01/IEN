{
  "name": "@workspace/ien-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts && PUPPETEER_CACHE_DIR=.cache/puppeteer puppeteer browsers install chrome && PUPPETEER_CACHE_DIR=.cache/puppeteer tsx scripts/prerender.ts",
    "build:spa": "vite build --config vite.config.ts",
    "prerender": "tsx scripts/prerender.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.3",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/serve-handler": "^6.1.4",
    "@vitejs/plugin-react": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "framer-motion": "catalog:",
    "lucide-react": "catalog:",
    "puppeteer": "^25.1.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "serve-handler": "^6.1.7",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "tw-animate-css": "^1.4.0",
    "vite": "catalog:",
    "wouter": "^3.3.5"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react-helmet-async": "^3.0.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3"
  }
}
